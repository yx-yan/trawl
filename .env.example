# Copy to .env (git-ignored). Without the Telegram pair, the digest is printed instead.
TRAWL_DATABASE_URL=postgresql://trawl:trawl@localhost:5432/trawl
TRAWL_TELEGRAM_TOKEN=
TRAWL_TELEGRAM_CHAT_ID=
# DeepSeek, for reading job descriptions (trawl process)
DEEPSEEK_API_KEY=
# Key for ~/.trawl/profile.enc (trawl profile init); kept here, apart from the file
TRAWL_PROFILE_KEY=
